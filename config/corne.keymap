#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 17>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 19>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 29>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };

        quotes {
            bindings = <&kp SQT>;
            key-positions = <21 22>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none       &kp Q             &kp W  &kp E         &kp R  &kp T        &kp Y      &kp U  &kp I              &kp O    &kp P                 &none
&kp ESCAPE  &kp A             &kp S  &kp D         &kp F  &kp G        &kp H      &kp J  &kp K              &kp L    &kp SEMI              &kp BACKSPACE
&none       &mt LEFT_SHIFT Z  &kp X  &kp C         &kp V  &kp B        &kp N      &kp M  &kp COMMA          &kp DOT  &mt RIGHT_SHIFT FSLH  &none
                                     &kp LEFT_GUI  &mo 2  &kp SPACE    &kp ENTER  &mo 3  &kp RIGHT_CONTROL
            >;
        };

        cmd2alt_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | ALT | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB     &kp N1     &kp N2  &kp N3  &kp N4     &kp N5       &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp ESCAPE  &kp F5     &kp Q   &kp W   &kp E      &kp T        &kp V      &kp X  &kp K      &kp L    &kp SEMI  &kp SQT
&kp FSLH    &kp LSHFT  &kp A   &kp S   &kp D      &kp F        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                               &kp F3  &kp RCTRL  &kp SPACE    &kp ENTER  &mo 3  &kp RCTRL
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none           &kp N1  &kp N2    &kp N3         &kp N4       &kp N5          &kp N6         &kp N7             &kp N8             &kp N9      &kp N0    &none
&kp LEFT_SHIFT  &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END         &kp LEFT       &kp DOWN           &kp UP             &kp RIGHT   &trans    &kp BACKSPACE
&none           &trans  &trans    &trans         &trans       &kp CAPSLOCK    &kp C_PREV     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &kp C_NEXT  &kp C_PP  &none
                                  &kp LEFT_GUI   &trans       &trans          &kp RIGHT_ALT  &mo 4              &kp RIGHT_CONTROL
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none           &kp EXCL   &kp AT          &kp HASH        &kp DLLR      &kp PRCNT          &kp CARET  &kp AMPS   &kp ASTRK          &kp LPAR  &kp RPAR       &none
&kp LEFT_SHIFT  &kp GRAVE  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT    &kp MINUS  &kp EQUAL  &trans             &trans    &kp BACKSLASH  &kp BACKSPACE
&none           &kp TILDE  &trans          &trans          &trans        &trans             &kp UNDER  &kp PLUS   &trans             &trans    &kp PIPE       &none
                                           &kp LEFT_GUI    &trans        &trans             &trans     &trans     &kp RIGHT_CONTROL
            >;
        };

        funciton_layer {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &bt BT_CLR    &trans        &trans        &tog 0        &tog 1        &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans     &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &trans        &trans        &trans
                          &trans  &trans  &trans     &trans        &trans        &trans
            >;
        };
    };
};
